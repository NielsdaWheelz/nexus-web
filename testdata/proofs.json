        "gradle:apps/android/app/src/androidTest/java/app/nexus/android/NativeAuthHandoffTest.kt::nativeAuthStartCarriesTheExactHandoffContractToTheOwnedOrigin"
      ],
      "capabilities": [
        "android-device",
        "android-release"
      ]
    }
  ],
