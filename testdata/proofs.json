{
  "version": 1,
  "priority_risks": [
    {
      "id": "test-environment-isolation",
      "source_globs": [
        "python/nexus_test_control/runtime.py",
        "python/nexus_test_control/services.py",
        "python/tests/testkit/**/*.py"
      ],
      "proofs": [
        "pytest:python/tests/kernel/nexus_test_control/test_isolation.py::test_environment_isolation_rejects_production_and_cleans_only_the_exact_run"
      ],
      "capabilities": [
        "kernel-python"
      ]
    },
    {
      "id": "auth-privacy-secrets",
      "source_globs": [
        "python/nexus/auth/**/*.py",
        "python/nexus/services/conversations.py",
        "apps/web/src/lib/auth/**/*.ts",
        "apps/web/src/lib/auth/**/*.tsx"
      ],
      "proofs": [
        "pytest:python/tests/service/test_auth_privacy.py::test_invalid_token_is_redacted_and_private_conversation_existence_is_masked"
      ],
      "capabilities": [
        "service"
      ]
    },
    {
      "id": "destructive-side-effects",
      "source_globs": [
        "python/nexus/services/media_deletion.py",
        "python/nexus/services/resource_graph/cleanup.py"
      ],
      "proofs": [
        "pytest:python/tests/service/test_destructive_side_effects.py::test_viewer_removal_preserves_shared_media_database_and_object"
      ],
      "capabilities": [
        "service"
      ]
    },
    {
      "id": "migration-compatibility",
      "source_globs": [
        "migrations/alembic/**/*.py"
      ],
      "proofs": [
        "pytest:python/tests/migrations/test_supported_upgrade.py::test_empty_owned_database_upgrades_to_the_single_head",
        "pytest:python/tests/migrations/test_podcast_publication_migration.py::test_0207_canonicalizes_only_legacy_podcast_publication_instants_and_reaches_head"
      ],
      "capabilities": [
        "migrations"
      ]
    },
    {
      "id": "costly-effects",
      "source_globs": [
        "python/nexus/services/billing.py",
        "python/nexus/services/billing_entitlements.py",
        "python/nexus/services/chat_run_usage.py",
        "python/nexus/services/llm_ledger.py",
        "python/nexus/services/rate_limit.py"
      ],
      "proofs": [
        "pytest:python/tests/service/test_costly_effects.py::test_token_budget_reservation_and_settlement_are_exactly_once"
      ],
      "capabilities": [
        "service"
      ]
    },
    {
      "id": "reading-progress",
      "source_globs": [
        "python/nexus/services/consumption/**/*.py",
        "apps/web/src/lib/reader/readerProgress.ts"
      ],
      "proofs": [
        "pytest:python/tests/service/test_reading_progress.py::test_reader_cursor_cas_rejects_stale_progress_without_partial_side_effects"
      ],
      "capabilities": [
        "service"
      ]
    },
    {
      "id": "citation-provenance-identity",
      "source_globs": [
        "python/nexus/services/retrieval_citation.py",
        "python/nexus/services/resource_graph/citations.py",
        "apps/web/src/lib/conversations/citations.ts"
      ],
      "proofs": [
        "pytest:python/tests/service/test_citation_provenance.py::test_published_citation_reconstructs_locator_from_canonical_evidence"
      ],
      "capabilities": [
        "service"
      ]
    },
    {
