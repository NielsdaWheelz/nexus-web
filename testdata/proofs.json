      "source_globs": [
        "python/nexus/jobs/**/*.py",
        "python/nexus/services/chat_run_idempotency.py"
      ],
      "proofs": [
        "pytest:python/tests/service/test_durable_job_replay.py::test_expired_claim_replays_once_and_fences_the_crashed_worker"
      ],
      "capabilities": [
        "service"
      ]
    },
    {
      "id": "database-object-convergence",
      "source_globs": [
        "python/nexus/storage/**/*.py",
        "python/nexus/services/media_deletion.py",
        "python/nexus/tasks/storage_object_cleanup.py"
      ],
      "proofs": [
        "pytest:python/tests/service/test_database_object_convergence.py::test_owned_object_write_and_document_delete_converge_across_postgres_and_minio"
      ],
      "capabilities": [
