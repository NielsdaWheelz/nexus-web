#!/usr/bin/env python3
"""Run a command whose git fetches the one private memory dependency over ssh.

UNIVERSAL_MEMORY_DEPLOY_KEY_FILE names the read-only deploy key. The url rewrite
and ssh command live only in this process tree's environment.
"""

import os
import shlex
import sys
from pathlib import Path

if len(sys.argv) < 2:
    raise SystemExit("usage: scripts/with-memory-git COMMAND [ARGUMENT ...]")
key = os.environ.get("UNIVERSAL_MEMORY_DEPLOY_KEY_FILE")
if not key:
    raise SystemExit("UNIVERSAL_MEMORY_DEPLOY_KEY_FILE is not set")
known_hosts = Path(__file__).resolve().with_name("github-known-hosts")
environment = os.environ.copy()
environment["GIT_SSH_COMMAND"] = shlex.join(
    [
        "ssh",
        "-F", "/dev/null",
        "-i", str(Path(key).resolve()),
        "-o", "IdentitiesOnly=yes",
        "-o", "BatchMode=yes",
        "-o", "StrictHostKeyChecking=yes",
        "-o", f"UserKnownHostsFile={known_hosts}",
        "-o", "GlobalKnownHostsFile=/dev/null",
    ]
)
count = int(environment.get("GIT_CONFIG_COUNT", "0"))
environment[f"GIT_CONFIG_KEY_{count}"] = (
    "url.ssh://git@github.com/NielsdaWheelz/universal-memory.git.insteadOf"
)
environment[f"GIT_CONFIG_VALUE_{count}"] = (
    "https://github.com/NielsdaWheelz/universal-memory.git"
)
environment["GIT_CONFIG_COUNT"] = str(count + 1)
environment["GIT_TERMINAL_PROMPT"] = "0"
os.execvpe(sys.argv[1], sys.argv[1:], environment)
