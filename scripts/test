#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(dirname "$script_dir")"

if [ "$#" -ne 0 ]; then
  echo "usage: ./scripts/test" >&2
  exit 2
fi

for command in actionlint bun git shellcheck uv; do
  command -v "$command" >/dev/null 2>&1 || {
    echo "error: $command is required" >&2
    exit 1
  }
done

cd "$repo_root"

actionlint .github/workflows/*.yml

shell_files=(scripts/test)
while IFS= read -r -d '' file; do
  if [[ -f "$file" ]]; then
    shell_files+=("$file")
  fi
done < <(git ls-files -z '*.sh')
shellcheck "${shell_files[@]}"

(
  cd python
  python_files=(
    .
    ../apps/api/main.py
    ../apps/codex_agent
    ../apps/worker/health.py
    ../apps/worker/main.py
    ../deploy/hetzner/release.py
  )
  uv run --frozen --no-sync ruff format --check "${python_files[@]}"
  uv run --frozen --no-sync ruff check "${python_files[@]}"
  uv run --frozen --no-sync pyright
)

(
  cd apps/web
  # the packaged offline shelf and the firefox extension are build outputs;
  # building them here proves both packages and feeds the CSS-token closure
  # check below.
  bun run build:offline-reading
  bun run build:extension
  bun run lint:css-tokens
  bun run lint
  bun run typecheck
)

migration_heads="$(
  cd migrations
  uv run --project ../python --frozen --no-sync alembic heads
)"
if [[ ! "$migration_heads" =~ ^[0-9a-z][0-9a-z_]{0,63}[[:space:]]\(head\)$ ]]; then
  echo "error: expected one canonical alembic head, got: $migration_heads" >&2
  exit 1
fi
printf 'migration graph: %s\n' "$migration_heads"
