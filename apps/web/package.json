{
  "name": "@nexus/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run build && bun run start",
    "build:next": "bun run build:android && rm -rf .next && node scripts/copy-pdfjs.mjs && next build",
    "build": "bun run build:next && node scripts/package-standalone.mjs",
    "start": "node .next/standalone/serve.mjs",
    "lint:css-tokens": "node scripts/check-css-tokens.mjs",
    "lint": "eslint src/ scripts/lab/ scripts/package-standalone.mjs scripts/serve.mjs scripts/probe-web.mjs --max-warnings 0",
    "typecheck": "rm -rf .next/types && next typegen && tsc --noEmit && tsc -p src/extension/tsconfig.json --noEmit",
    "build:shelf": "vite build --config vite.shelf.config.ts",
    "build:extension": "node scripts/build-extension.mjs",
    "gen:wire": "node scripts/gen-wire.mjs",
    "gen:chat-citations": "node scripts/gen-chat-citations.mjs",
    "build:android": "bun run build:authored && vite build --config vite.android.config.ts",
    "build:packaged": "bun run build:shelf && bun run build:android",
    "build:authored": "vite build --config vite.authored.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^1.8.0",
    "next": "15.5.22",
    "pdfjs-dist": "5.7.284",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.8",
    "react": "^19.2.5",
    "react-aria": "3.53.1",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-stately": "3.51.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "@nexus/authored": "file:../../node/authored",
    "@journeyapps/wa-sqlite": "2.0.8",
    "yjs": "13.6.33",
    "fractional-indexing": "4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "1.64.1",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/mdast": "4.0.4",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.22",
    "mdast-util-from-markdown": "2.0.3",
    "openapi-typescript": "7.13.0",
    "typescript": "^6.0.2",
    "vercel": "58.7.1",
    "vite": "8.0.16"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "js-yaml": "4.3.0",
    "postcss": "8.5.18",
    "sharp": "0.35.0",
    "ws": "8.21.0"
  },
  "patchedDependencies": {
    "minimatch@3.1.5": "patches/minimatch@3.1.5.patch",
    "@dnd-kit/core@6.3.1": "patches/@dnd-kit%2Fcore@6.3.1.patch"
  }
}
