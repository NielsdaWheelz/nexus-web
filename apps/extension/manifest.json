{
  "manifest_version": 2,
  "name": "Nexus Capture",
  "version": "1.0.0",
  "description": "Save the current article, or a linked PDF or EPUB, to your Nexus.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Save to Nexus",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "permissions": ["activeTab", "identity", "scripting", "storage", "menus"],
  "optional_permissions": ["http://*/*", "https://*/*"],
  "incognito": "not_allowed",
  "browser_specific_settings": {
    "gecko": {
      "id": "capture@nexus.local",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "browsingActivity"]
      }
    }
  }
}
