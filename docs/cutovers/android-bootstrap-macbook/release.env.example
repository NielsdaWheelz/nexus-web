# Secrets for the one-time android-v0.2.14 bootstrap release.
# Copy to ~/.config/nexus-release/release.env (chmod 600) and fill in.

# Release signing keystore — only the operator holds these; GitHub's copies
# are write-only secrets.
NEXUS_ANDROID_RELEASE_STORE_FILE=/absolute/path/to/nexus-release.jks
NEXUS_ANDROID_RELEASE_STORE_PASSWORD=
NEXUS_ANDROID_RELEASE_KEY_ALIAS=
NEXUS_ANDROID_RELEASE_KEY_PASSWORD=

# Optional; derived from the keystore when left unset.
#NEXUS_ANDROID_RELEASE_CERT_SHA256=

# Provider certification + retention attestation: append from the dev server
# (see runbook.md) or paste here.
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GEMINI_API_KEY=
#MOONSHOT_API_KEY=
#DEEPSEEK_API_KEY=
#NEXUS_FABLE_RETENTION_ACCEPTED_AT=
