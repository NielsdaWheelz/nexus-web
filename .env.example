# Nexus Environment Configuration Example
# copy to .env and fill in values; make dev writes live local auth settings to .dev-ports.

# =============================================================================
# Application Config
# =============================================================================

# Environment: local | test | staging | prod
NEXUS_ENV=local

# =============================================================================
# Database URLs (standalone local Docker Postgres on port 54320)
# =============================================================================

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:54320/postgres
# Optional backend SQLAlchemy pool. Defaults are bounded for local/dev and small production DBs.
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
# DATABASE_POOL_TIMEOUT_SECONDS=30

# Optional: local port overrides used by Makefile/dev scripts
# POSTGRES_PORT=54320
# MINIO_PORT=9000
# SUPABASE_DB_PORT=54322
# API_PORT=8000
# WEB_PORT=3000
# LOCAL_COMPOSE_PROJECT=nexus-local

# =============================================================================
# Supabase Local Configuration
# Run `supabase status` to get these public values after `supabase start`
# =============================================================================

# Local Supabase API URL. Used by local development
# tooling; it is not a runtime application setting (FastAPI reads
# SUPABASE_ISSUER/SUPABASE_JWKS_URL/SUPABASE_AUDIENCES instead). Default shown.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<your-anon-key-from-supabase-status>
# Optional Supabase CLI/account variants. Prefer SUPABASE_ANON_KEY in normal app env.
# SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
# Supabase admin credentials are local development bootstrap-only. Never persist this value in
# `.env`, `.dev-ports`, app runtime env, deploy env, Vercel, or VPS env files.
# SUPABASE_AUTH_ADMIN_KEY=<local-secret-key>

# Forbidden in app runtime env files; the deploy env sync scripts reject these
# names.
# SUPABASE_DATABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SERVICE_ROLE_KEY=

# =============================================================================
# Supabase Auth Settings (required in all environments)
# These are used by FastAPI to verify JWT tokens
# =============================================================================

SUPABASE_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_AUDIENCES=authenticated
# Canonical public app origin. In hosted Supabase Auth, this is the production
# `site_url`; every auth redirect origin below must have an exact
# `${origin}/auth/callback` redirect URL configured.
# APP_PUBLIC_URL=http://localhost:3000
# Strict callback redirect-origin allowlist used by apps/web auth callback route.
# Includes 10.0.2.2 for Android emulator debug builds.
# Production must contain only canonical public HTTPS app origins.
AUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.0.2.2:3000,http://localhost:3001,http://127.0.0.1:3001
# Optional. Only set when `/auth/callback` receives a private internal origin
# and trusted `x-forwarded-*` headers from a known proxy.
# AUTH_TRUSTED_PROXY_ORIGINS=
# Optional. Next.js Server Action CSRF admission list for host-rewriting
# frontend proxies only. Values are domain patterns such as app.example.com or
# *.app.example.com, not URL origins. Empty is correct for direct Vercel.
# SERVER_ACTION_ALLOWED_ORIGINS=
# Firefox extension identity callback origin: the origin of
# browser.identity.getRedirectURL(), https://<hash>.extensions.allizom.org,
# where <hash> is the sha-1 hex of the gecko id. For capture@nexus.local:
# https://1ddcf81c2e8737ef7e045031d91fb2c3d6b899ae.extensions.allizom.org
# (confirm with browser.identity.getRedirectURL() in the background console
# under about:debugging).
NEXUS_EXTENSION_REDIRECT_ORIGINS=
# Firefox extension build origins (read by `bun run build:extension`, baked into
# the package; the popup has no editable base URL). The nexus origin serves the
# BFF and hosted login; the storage origin receives signed upload PUTs. Their
# exact match patterns (port dropped) become manifest optional_permissions.
# Local defaults shown.
NEXUS_EXTENSION_NEXUS_ORIGIN=http://localhost:3000
NEXUS_EXTENSION_STORAGE_ORIGIN=http://127.0.0.1:9000
# Operator-only Supabase Management API token, for dashboard-equivalent checks.
# Never sync this to Vercel or the VPS runtime env.
# SUPABASE_MANAGEMENT_ACCESS_TOKEN=
# Review hosted provider state in the Supabase dashboard when auth changes:
# public signup, anonymous users, phone, custom OAuth, SAML, passkeys, CAPTCHA,
# HIBP, auth hooks, third-party Auth integrations, unverified-email sign-in,
# and reauthentication off;
# email/Google/GitHub and identity linking on; confirmation and a 15-character
# minimum password; production SMTP; Nexus invite/recovery templates;
# password-change notification; exact site URL and callbacks.

# =============================================================================
# Supabase OAuth Providers (required for interactive Google/GitHub login)
# Enable the matching provider blocks in supabase/config.toml after provisioning
# provider credentials in the target environment.
# Provider callback URL (local Supabase): http://127.0.0.1:54321/auth/v1/callback
# App redirect URLs: http://localhost:3000/auth/callback
# The local web callback-origin allowlist also includes 127.0.0.1, 10.0.2.2,
# and the first fallback dev port (3001). Production OAuth must use verified
# HTTPS app callback URLs only.
# =============================================================================

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<google-client-id>
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=<google-client-secret>
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=<github-client-id>
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_SECRET=<github-client-secret>

# =============================================================================
# Android self-distributed release APK
# Required only when building a signed release APK.
# The certificate fingerprint must match apps/web/public/.well-known/assetlinks.json.
# Store passwords and keystore bytes in GitHub secrets for release automation.
# =============================================================================

# NEXUS_ANDROID_RELEASE_BASE_URL=https://nexus.nielseriknandal.com
# NEXUS_ANDROID_RELEASE_OWNED_HOST=nexus.nielseriknandal.com
# Must equal backend STREAM_BASE_URL's exact public HTTPS origin; the APK pins
# direct offline-reading package transfers to it.
# NEXUS_ANDROID_RELEASE_API_ORIGIN=https://api.example.com
# NEXUS_ANDROID_RELEASE_STORE_FILE=/absolute/path/to/nexus-release.jks
# NEXUS_ANDROID_RELEASE_STORE_PASSWORD=<release-keystore-password>
# NEXUS_ANDROID_RELEASE_KEY_ALIAS=nexus-release
# NEXUS_ANDROID_RELEASE_KEY_PASSWORD=<release-key-password>
# NEXUS_ANDROID_RELEASE_CERT_SHA256=<release-signing-cert-sha256>
# NEXUS_ANDROID_VERSION_CODE=<monotonic-integer>
# NEXUS_ANDROID_VERSION_NAME=<version-name>
# Required for all Android builds. Google OAuth Web client ID used by
# Credential Manager as serverClientId and by Supabase as the Google ID-token
# audience. No default; keep the value in local/CI environment, not committed
# Gradle properties.
# NEXUS_GOOGLE_WEB_CLIENT_ID=<google-web-oauth-client-id>
# GitHub release workflow additionally needs NEXUS_ANDROID_RELEASE_KEYSTORE_BASE64 as a secret.

# Optional Android SDK locations for local builds.
# ANDROID_HOME=/absolute/path/to/Android/sdk
# ANDROID_SDK_ROOT=/absolute/path/to/Android/sdk

# =============================================================================
# Internal Secret (required in staging/prod only)
# Used for BFF -> FastAPI authentication
# =============================================================================

# NEXUS_INTERNAL_SECRET=<generate-a-secure-random-string>

# =============================================================================
# Production Config Publication (optional explicit input paths)
# =============================================================================

# These path overrides select the explicit tracked-contract inputs consumed by
# deploy/vercel/sync-env.sh and deploy/hetzner/sync-env.sh.
# These commands only publish config;
# none activates a release. Production coordinates and
# release identity are committed inputs, not ambient environment settings.
# NEXUS_SHARED_ENV=deploy/env/env-prod
# NEXUS_FRONTEND_ENV=deploy/env/env-prod-frontend
# NEXUS_BACKEND_ENV=deploy/env/env-prod-backend
# NEXUS_WORKER_ENV=deploy/env/env-prod-worker
# Optional backup input path (default shown):
# NEXUS_BACKUP_ENV=deploy/env/env-prod-backup
# R2_BACKUP_S3_API_ORIGIN, R2_BACKUP_BUCKET, R2_BACKUP_ACCESS_KEY_ID, and
# R2_BACKUP_SECRET_ACCESS_KEY are required there, with no defaults;
# see deploy/env/env-prod-backup.example. Never add them to application env.
# NEXUS_BACKUP_CONFIG_FILE and NEXUS_BACKUP_STATE_DIRECTORY are controller-owned
# inputs required when the backup helper runs. Inactive Compose defaults are
# /dev/null and /var/backups/nexus/r2; these are not operator settings.
# PGHOST, PGPORT, PGUSER, PGPASSWORD, and PGDATABASE are required helper inputs
# supplied by Compose from the captured database config, never from this file.
# The helper fixes PGCONNECT_TIMEOUT to 10 seconds for its PostgreSQL child.
# Required for production Oracle reconciliation. Set to the production user id
# that should own the system library membership.
# NEXUS_ORACLE_CORPUS_OWNER_USER_ID=<prod-user-uuid>

# =============================================================================
# Cloudflare Operator Tooling
# =============================================================================

# Optional Cloudflare API settings for deploy/cloudflare/apply-r2-lifecycle.sh.
# Required only when applying R2 lifecycle rules from the CLI.
# CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
# CLOUDFLARE_API_TOKEN=<cloudflare-api-token-with-r2-edit>
# R2_LIFECYCLE_FILE=deploy/cloudflare/r2-lifecycle.example.json

# =============================================================================
# Generation and transcript embedding
# OPENAI_API_KEY remains only for the direct transcript-embedding path.
# =============================================================================

# OPENAI_API_KEY=<your-openai-api-key>
# API generation is optional in local/test and backend-only. List only enabled
# providers; each entry requires its dedicated credential. Production must list
# at least one provider. Never expose these values to the web application or the
# isolated Codex Personal host.
# GENERATION_API_PROVIDERS=openai,anthropic,gemini,deepseek,xai
# OPENAI_GENERATION_API_KEY=<openai-generation-api-key>
# ANTHROPIC_GENERATION_API_KEY=<anthropic-generation-api-key>
# GEMINI_GENERATION_API_KEY=<gemini-generation-api-key>
# DEEPSEEK_GENERATION_API_KEY=<deepseek-generation-api-key>
# XAI_GENERATION_API_KEY=<xai-generation-api-key>
# GENERATION_CONTINUATION_ENCRYPTION_KEY=<base64-encoded-distinct-32-byte-key>
# NEXUS_FABLE_RETENTION_ACCEPTED_AT=<timezone-aware-ISO-8601-instant>
# Dedicated HS256 secret for run-scoped agent-tool grants. Required in staging
# and production; use a distinct random value of at least 32 bytes.

# Rate limiting
# RATE_LIMIT_RPM=20

# =============================================================================
# Public Web Search
# =============================================================================

# Brave Search API key used by the chat web_search tool.
# If unset, required web search fails closed with a typed unavailable result.
# BRAVE_SEARCH_API_KEY=<your-brave-search-api-key>

# Optional Brave Search settings.
# BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1
# BRAVE_SEARCH_TIMEOUT_SECONDS=8

# =============================================================================
# Streaming — Direct browser->FastAPI SSE
# =============================================================================

# HS256 signing key for stream tokens (base64-encoded, 32+ bytes)
# Required in staging/prod; auto-generated deterministic key in local/test
# STREAM_TOKEN_SIGNING_KEY=<base64-encoded-32-byte-key>

# Public URL browsers use for /stream/* (e.g. https://api.nexus.example.com)
# Defaults to http://localhost:8000 in local/test
# STREAM_BASE_URL=http://localhost:8000

# Comma-separated allowed CORS origins for /stream/* endpoints (no wildcard)
# STREAM_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# Synapse Resonance Engine
# =============================================================================

# SYNAPSE_ENABLED=true

# =============================================================================
# Metadata Enrichment
# =============================================================================

# Optional. Max characters of extracted text sampled into the enrichment
# prompt; the assembled turn is independently clamped to the native-agent
# input byte bound.
# METADATA_ENRICHMENT_MAX_CONTENT_CHARS=2000

# Optional. Unix socket where workers reach the private Codex agent host.
# Production sets it in the compose file; runtime env files must not carry it
# (Compose owns it; runtime env files must not).
# NEXUS_CODEX_AGENT_SOCKET=/run/nexus-codex/agent.sock

# Interactive worker only. Production Compose owns the dedicated MCP listener;
# runtime env files must not carry this setting.
# NEXUS_AGENT_TOOLS_MCP_LISTEN=0.0.0.0:8001
# NEXUS_AGENT_TOOLS_MCP_ORIGIN=https://api.example.com/internal/agent-tools/mcp

# Codex agent host process only (apps/codex_agent). Required by the host; set
# in the compose file, never in runtime env files.
# NEXUS_CODEX_CREDENTIAL_FILE=/run/nexus-codex-credential/auth.json  # exact RW file bind
# NEXUS_CODEX_WORKING_DIRECTORY_ROOT=/tmp/nexus-codex-turns
# NEXUS_CODEX_MCP_ORIGIN=https://api.example.com/internal/agent-tools/mcp
# NEXUS_CODEX_MODEL_TOOL_NETWORK_ATTESTED=true

# Interactive enrollment entrypoint only (apps/codex_agent/enroll.py): the
# temporary Codex profile directory the device-auth login writes, plus the
# one-shot encrypted auth-file target. Passed on the enrollment command line,
# never in runtime env files.
# CODEX_HOME=/tmp/nexus-codex-enrollment
# NEXUS_CODEX_ENROLLMENT_AUTH_FILE=/var/lib/nexus-codex/codex/codex-personal/auth.json

# =============================================================================
# Transcript Semantic Embedding
# =============================================================================

# TRANSCRIPT_EMBEDDING_MODEL_OPENAI=text-embedding-3-small
# TRANSCRIPT_EMBEDDING_DIMENSIONS=256

# =============================================================================
# Podcast Discovery + Subscription Provider
# =============================================================================

# YouTube transcript provider timeout for direct video transcript ingestion.
# YOUTUBE_TRANSCRIPT_TIMEOUT_SECONDS=30
# Optional. Required on cloud hosts where YouTube blocks unauthenticated
# transcript/caption scraping from datacenter IP ranges. Use a rotating
# residential proxy URL; keep credentials backend-only.
# YOUTUBE_TRANSCRIPT_PROXY_URL=http://user:password@proxy.example.com:8080
# YOUTUBE_TRANSCRIPT_PROXY_RETRIES_WHEN_BLOCKED=3

# Global feature flag for podcasts routes/jobs.
# If true, Podcast Index credentials are required.
PODCASTS_ENABLED=false
# PODCAST_INDEX_API_KEY=<your-podcast-index-api-key>
# PODCAST_INDEX_API_SECRET=<your-podcast-index-api-secret>
# Optional. Default shown.
# PODCAST_INDEX_BASE_URL=https://api.podcastindex.org/api/1.0

# =============================================================================
# Browse Providers
# =============================================================================

# Required in staging/prod for browse provider startup.
# Optional in local/test; browse calls that require it fail closed when unset.
# YOUTUBE_DATA_API_KEY=<your-youtube-data-api-key>
# Optional. Default shown.
# YOUTUBE_DATA_BASE_URL=https://www.googleapis.com/youtube/v3

# Official X API bearer token for archival public X/Twitter thread ingestion.
# Required in staging/prod for backend startup.
# Optional in local/test; X captures fail closed when unset.
# X_API_BEARER_TOKEN=<your-x-api-bearer-token>
# Optional. Defaults shown.
# X_API_BASE_URL=https://api.x.com/2
# X_API_TIMEOUT_SECONDS=10
# X_API_AUTHOR_THREAD_MAX_POSTS=1000

# =============================================================================
# Podcast Transcription
# =============================================================================

# Deepgram provider key for real podcast transcription.
# If unset, podcast transcript generation will fail closed with explicit
# transcription error codes.
# DEEPGRAM_API_KEY=<your-deepgram-api-key>

# Optional Deepgram settings
# DEEPGRAM_BASE_URL=https://api.deepgram.com
# DEEPGRAM_MODEL=nova-3
# PODCAST_TRANSCRIPTION_TIMEOUT_SECONDS=90

# =============================================================================
# Podcast Freshness Scheduling
# =============================================================================

# Defaults are shown. Production requires a positive due schedule.
# PODCAST_REFRESH_DUE_SCHEDULE_SECONDS=900
# PODCAST_REFRESH_DUE_LIMIT=100

# =============================================================================
# Ingest Recovery & Reconciliation
# =============================================================================

# Reconciliation is production background work and dispatches durable jobs only.
# INGEST_RECONCILE_SCHEDULE_SECONDS=600
# INGEST_STALE_EXTRACTING_SECONDS=1800

# =============================================================================
# Worker Runtime
# =============================================================================

# Normal entrypoints set WORKER_LANE=interactive or background. A bounded
# maintenance invocation sets WORKER_LANE=maintenance,
# NEXUS_ALLOW_WORKER_MAINTENANCE=1, and an exact maintenance-only
# WORKER_ALLOWED_JOB_KINDS subset on that process.
# WORKER_POLL_INTERVAL_SECONDS=5
# WORKER_IDLE_BACKOFF_MAX_SECONDS=300
# WORKER_SCHEDULER_INTERVAL_SECONDS=300
# WORKER_HEARTBEAT_INTERVAL_SECONDS=60
# WORKER_LEASE_SECONDS=300
# WORKER_DB_FAILURE_BACKOFF_SECONDS=60
# WORKER_DB_FAILURE_BACKOFF_MAX_SECONDS=900
# Optional local Docker Compose worker overlay overrides. Defaults shown.
# WORKER_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/postgres
# WORKER_SUPABASE_JWKS_URL=http://host.docker.internal:54321/auth/v1/.well-known/jwks.json
# WORKER_R2_S3_API_ORIGIN=http://minio:9000
# SYNC_GUTENBERG_CATALOG_SCHEDULE_SECONDS=0
# BACKGROUND_JOB_PRUNE_SCHEDULE_SECONDS=0
# BACKGROUND_JOB_PRUNE_SUCCEEDED_AFTER_DAYS=7
# BACKGROUND_JOB_PRUNE_DEAD_AFTER_DAYS=30
# BACKGROUND_JOB_PRUNE_BATCH_SIZE=100

# =============================================================================
# Billing / Stripe
# =============================================================================

# APP_PUBLIC_URL=http://localhost:3000
# BILLING_ENABLED=true
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PLUS_PRICE_ID=price_...
# STRIPE_AI_PLUS_PRICE_ID=price_...
# STRIPE_AI_PRO_PRICE_ID=price_...
# BILLING_AI_PLUS_TRANSCRIPTION_MINUTES_MONTHLY=300
# BILLING_AI_PRO_TRANSCRIPTION_MINUTES_MONTHLY=1200

# =============================================================================
# Storage Limits
# =============================================================================

# Object storage. Required in staging/prod. Local development uses MinIO with
# the R2-compatible values shown here.
R2_S3_API_ORIGIN=http://127.0.0.1:9000
R2_ACCESS_KEY_ID=nexus-local-access-key
R2_SECRET_ACCESS_KEY=nexus-local-secret-key
R2_BUCKET=media
R2_REGION=us-east-1
# MAX_PDF_BYTES=104857600
# MAX_EPUB_BYTES=52428800
# SIGNED_URL_EXPIRY_S=300
# Must remain greater than the browser's fixed 240-second direct-upload PUT horizon.
# STORAGE_OBJECT_CLEANUP_WRITE_WINDOW_SECONDS=300

# EPUB archive safety limits
# MAX_EPUB_ARCHIVE_ENTRIES=10000
# MAX_EPUB_ARCHIVE_TOTAL_UNCOMPRESSED_BYTES=536870912
# MAX_EPUB_ARCHIVE_SINGLE_ENTRY_UNCOMPRESSED_BYTES=67108864
# MAX_EPUB_ARCHIVE_COMPRESSION_RATIO=100
# MAX_EPUB_ARCHIVE_PARSE_TIME_MS=30000

# =============================================================================
# Frontend (apps/web/.env.local — separate file, listed here for reference)
# =============================================================================

# Required in staging/prod. Defaults to http://localhost:8000 in local/test.
# FASTAPI_BASE_URL=http://localhost:8000
# NEXUS_ENV=local
# Build/run mode, owned by the Next.js toolchain (`next dev` → development; `next build`/
# `next start` → production). Optional; do not set manually — the deployment axis is NEXUS_ENV.
# NODE_ENV=
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
# AUTH_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.0.2.2:3000,http://localhost:3001,http://127.0.0.1:3001
# AUTH_TRUSTED_PROXY_ORIGINS=
# SERVER_ACTION_ALLOWED_ORIGINS=
# Required in staging/prod.
# NEXUS_INTERNAL_SECRET=<generate-a-secure-random-string>
# R2_S3_API_ORIGIN is also used by frontend CSP connect-src in production.
# Optional comma-separated media origins beyond same-origin and HTTPS defaults.
# CSP_MEDIA_ORIGINS=
