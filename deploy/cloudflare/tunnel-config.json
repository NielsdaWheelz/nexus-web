{
  "config": {
    "ingress": [
      {
        "hostname": "nexus-api.nielseriknandal.com",
        "path": "^/public/resource-share(?:/.*)?$",
        "service": "http_status:503"
      },
      {
        "hostname": "nexus-api.nielseriknandal.com",
        "service": "http://caddy:80",
