{
  "http_request_firewall_custom": {
    "rules": [
      {
        "ref": "nexus_web_machine_requests",
        "description": "nexus web: skip browser checks while retaining managed waf",
        "expression": "http.host eq \"nexus.nielseriknandal.com\"",
        "action": "skip",
        "action_parameters": {
          "products": ["bic", "securityLevel"]
        },
        "logging": {
          "enabled": true
        },
        "enabled": true
      }
    ]
  },
  "http_request_cache_settings": {
    "rules": [
      {
        "ref": "nexus_web_cache_bypass",
        "description": "nexus web: bypass shared edge caching",
        "expression": "http.host eq \"nexus.nielseriknandal.com\"",
        "action": "set_cache_settings",
        "action_parameters": {
          "cache": false
        },
        "enabled": true
      }
    ]
  }
}
