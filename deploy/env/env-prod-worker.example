# Worker-only env for the Hetzner VPS.
# Compose assigns each worker its lane (WORKER_LANE). Leases, heartbeats and the
# idle wait are fixed by the job runtime, not configured here.

PARSER_TEMP_ROOT=/var/lib/nexus/parser-tmp

# Connection discovery scans (connection_discovery_scan jobs no-op when false).
# CONNECTION_DISCOVERY_ENABLED=true

# Grand atlas nightly re-projection (0 disables the periodic sweep).
ATLAS_PROJECT_SCHEDULE_SECONDS=86400

# Reconciliation is production background work.
INGEST_RECONCILE_SCHEDULE_SECONDS=600

# Podcast freshness is ordinary background-lane work.
PODCAST_REFRESH_DUE_SCHEDULE_SECONDS=900
PODCAST_REFRESH_DUE_LIMIT=100

# Background-job pruning runs on the background lane; these bound its retention.
BACKGROUND_JOB_PRUNE_SUCCEEDED_AFTER_DAYS=7
BACKGROUND_JOB_PRUNE_DEAD_AFTER_DAYS=30
BACKGROUND_JOB_PRUNE_BATCH_SIZE=100
