# Worker-only env for the Hetzner VPS.
# Compose assigns each normal worker its fixed lane. Raw allowlists are reserved
# for gated, one-off maintenance invocations and do not belong in this file.

WORKER_POLL_INTERVAL_SECONDS=5
WORKER_IDLE_BACKOFF_MAX_SECONDS=300
WORKER_SCHEDULER_INTERVAL_SECONDS=300
WORKER_HEARTBEAT_INTERVAL_SECONDS=60
WORKER_LEASE_SECONDS=300
WORKER_DB_FAILURE_BACKOFF_SECONDS=60
WORKER_DB_FAILURE_BACKOFF_MAX_SECONDS=900

# Synapse resonance scans (synapse_scan jobs no-op when false).
# SYNAPSE_ENABLED=true

# Dawn write morning brief (dawn_write_job no-op when false).
# DAWN_WRITE_ENABLED=true
DAWN_WRITE_SCHEDULE_SECONDS=3600

# Grand atlas nightly re-projection (0 disables the periodic sweep).
ATLAS_PROJECT_SCHEDULE_SECONDS=86400

# Reconciliation is production background work.
INGEST_RECONCILE_SCHEDULE_SECONDS=600
INGEST_SEMANTIC_REPAIR_BATCH_LIMIT=25

# Podcast freshness is ordinary background-lane work.
PODCAST_REFRESH_DUE_SCHEDULE_SECONDS=900
PODCAST_REFRESH_DUE_LIMIT=100

# Maintenance-only schedules remain disabled in the normal production env.
SYNC_GUTENBERG_CATALOG_SCHEDULE_SECONDS=0
BACKGROUND_JOB_PRUNE_SCHEDULE_SECONDS=0
BACKGROUND_JOB_PRUNE_SUCCEEDED_AFTER_DAYS=7
BACKGROUND_JOB_PRUNE_DEAD_AFTER_DAYS=30
BACKGROUND_JOB_PRUNE_BATCH_SIZE=100

# The worker image sets NODE_INGEST_SCRIPT for production. Override only if needed.
# NODE_INGEST_SCRIPT=/app/node/ingest/ingest.mjs
