# Vercel frontend env.
# Import/set these in the Vercel project for the production environment.

FASTAPI_BASE_URL=https://api.example.com
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# The app's one public origin is APP_PUBLIC_URL (shared env). The firefox
# extension's identity redirect origin: blank or exactly one https origin.
NEXUS_EXTENSION_REDIRECT_ORIGINS=
