# operator-only database backup credentials; never merge into application env.
# use a separate private bucket and a token scoped to that bucket.
R2_BACKUP_S3_API_ORIGIN=https://<account-id>.r2.cloudflarestorage.com
R2_BACKUP_BUCKET=nexus-database-backups
R2_BACKUP_ACCESS_KEY_ID=<backup-access-key-id>
R2_BACKUP_SECRET_ACCESS_KEY=<64-hex-s3-secret-access-key-not-api-token>
