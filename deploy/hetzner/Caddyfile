{
	email {$CADDY_ACME_EMAIL}
	log default {
		format filter {
			request>headers>Authorization delete
			request>headers>Cookie delete
			request>headers>X-Nexus-Internal delete
		}
	}
}

{$CADDY_SITE} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	route {
		# An offline reading copy builds before its first byte: long header
		# timeout, and no encode (the zip is already compressed).
		@reading_copy path_regexp ^/stream/media/[0-9a-f-]{36}/reading-copy$
		handle @reading_copy {
			reverse_proxy api:8000 {
				transport http {
					dial_timeout 20s
					response_header_timeout 660s
					read_timeout 3600s
					write_timeout 3600s
				}
			}
		}

		handle {
			encode zstd gzip
			reverse_proxy api:8000
		}
	}
}
