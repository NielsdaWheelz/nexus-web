# syntax=docker/dockerfile:1
ARG TARGETARCH
FROM scratch AS extension-amd64
ADD --checksum=sha256:c444e4ada13831a7431be0f1aa99da696380e3c431360202113dbf9f44c8a074 https://github.com/paradedb/paradedb/releases/download/v0.26.2/postgresql-15-pg-search_0.26.2-1PARADEDB-bookworm_amd64.deb /pg-search.deb

FROM scratch AS extension-arm64
ADD --checksum=sha256:0fbc59149ecbebb161d6cab62c161f33a7f7f0c2f54b69e7e8597a12f05e8038 https://github.com/paradedb/paradedb/releases/download/v0.26.2/postgresql-15-pg-search_0.26.2-1PARADEDB-bookworm_arm64.deb /pg-search.deb

FROM extension-${TARGETARCH} AS extension
FROM pgvector/pgvector:pg15@sha256:47af0b65960b14f1c6945aa4ccae37836c632e9a6fe0eea9160936e616e5b2e9 AS postgres-base

# Rebuild one complete matching PGXS package. The patch adds interrupt safe points
# after releasing each IVF scan page; index data, metrics and SQL stay unchanged.
FROM postgres-base AS vector-build
ADD --checksum=sha256:cac0b10c360f05b2d521200105ba3697e773d4cd3731f5a915a7e37ebe0bea85 https://github.com/pgvector/pgvector/archive/refs/tags/v0.8.7.tar.gz /tmp/pgvector.tar.gz
COPY docker/pgvector/0.8.7-ivfflat-interrupts.patch /tmp/ivfflat-interrupts.patch
RUN apt-get update \
    && apt-get install -y --no-install-recommends --no-upgrade \
        build-essential patch "postgresql-server-dev-15=$PG_VERSION" \
    && test "$PG_MAJOR" = 15 \
    && test "$(/usr/lib/postgresql/15/bin/pg_config --version | awk '{print $2}')" = "${PG_VERSION%%-*}" \
    && tar -xzf /tmp/pgvector.tar.gz -C /tmp \
    && cd /tmp/pgvector-0.8.7 \
    && cmp vector.control /usr/share/postgresql/15/extension/vector.control \
    && patch --batch --forward --fuzz=0 -p1 < /tmp/ivfflat-interrupts.patch \
    && make -j1 PG_CONFIG=/usr/lib/postgresql/15/bin/pg_config OPTFLAGS="" \
    && make PG_CONFIG=/usr/lib/postgresql/15/bin/pg_config OPTFLAGS="" DESTDIR=/out install \
    && test -s /out/usr/lib/postgresql/15/lib/bitcode/vector.index.bc \
    && mkdir -p /out/usr/share/doc/pgvector \
    && { \
        printf 'upstream_version=0.8.7\narchive_sha256=cac0b10c360f05b2d521200105ba3697e773d4cd3731f5a915a7e37ebe0bea85\npatch=ivfflat-interrupts-1\noptflags=empty\n'; \
        printf 'postgres_headers=%s\n' "$(dpkg-query -W -f='${Version}' postgresql-server-dev-15)"; \
        printf 'patch_sha256=%s\n' "$(sha256sum /tmp/ivfflat-interrupts.patch | awk '{print $1}')"; \
        printf 'binary_sha256=%s\n' "$(sha256sum /out/usr/lib/postgresql/15/lib/vector.so | awk '{print $1}')"; \
    } > /out/usr/share/doc/pgvector/nexus-build.txt \
    && cd /out \
    && find usr/lib/postgresql/15 usr/share/postgresql/15/extension -type f -print0 \
        | LC_ALL=C sort -z | xargs -0 sha256sum > usr/share/doc/pgvector/nexus-package.sha256

FROM postgres-base
COPY --from=vector-build /out/usr/lib/postgresql/15/ /usr/lib/postgresql/15/
COPY --from=vector-build /out/usr/share/postgresql/15/extension/ /usr/share/postgresql/15/extension/
COPY --from=vector-build /out/usr/share/doc/pgvector/ /usr/share/doc/pgvector/
COPY docker/pgvector/0.8.7-ivfflat-interrupts.patch /usr/share/doc/pgvector/ivfflat-interrupts.patch
COPY --chmod=0755 docker/pgvector/check-runtime.sh /usr/local/bin/nexus-postgres-check
COPY --from=extension /pg-search.deb /tmp/pg-search.deb
RUN apt-get update \
    && apt-get install -y --no-install-recommends --no-upgrade \
        libopenblas0=0.3.21+ds-4 libopenblas0-pthread=0.3.21+ds-4 \
    && dpkg --install /tmp/pg-search.deb \
    && rm /tmp/pg-search.deb \
    && rm -rf /var/lib/apt/lists/*
