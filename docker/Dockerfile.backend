# Unified immutable backend image for the API and worker release targets.

FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2 AS python-dependencies

COPY --from=ghcr.io/astral-sh/uv:0.13.4@sha256:9f130421e930bfbdc563c00740466603f8723158e90297d07957c2294640262b /uv /uvx /usr/local/bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge 20250419~deb12u2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY python/pyproject.toml python/uv.lock python/README.md ./
RUN uv sync --frozen --no-dev --no-install-project

FROM python-dependencies AS python-builder

COPY python/nexus ./nexus
RUN chmod -R u=rwX,go=rX /app/nexus \
    && uv sync --frozen --no-dev --no-editable


# The subscription-authenticated host is part of the worker release identity,
# never the API/migration artifact.  Keep its SDK/runtime dependency out of the
# base environment so an API compromise cannot read or use Codex credentials.
FROM python-dependencies AS worker-python-dependencies

RUN uv sync --frozen --no-dev --no-install-project --extra codex-agent

FROM worker-python-dependencies AS worker-python-builder

COPY python/nexus ./nexus
RUN chmod -R u=rwX,go=rX /app/nexus \
    && uv sync --frozen --no-dev --no-editable --extra codex-agent


FROM python-builder AS release-metadata

ARG SOURCE_SHA

COPY migrations ./migrations
RUN chmod -R u=rwX,go=rX /app/migrations \
    && /app/.venv/bin/python -m nexus.release_artifact write-runtime-identity \
        --repo-root /app \
        --source-sha "$SOURCE_SHA" \
        --output /app/runtime-identity.json \
    && chown root:root /app/runtime-identity.json \
    && chmod 0444 /app/runtime-identity.json


FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS node-builder

WORKDIR /app/node/ingest

COPY node/ingest/package.json node/ingest/bun.lock* ./
RUN bun install --frozen-lockfile --production


FROM node:22.23.2-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS node-runtime


FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2 AS backend-runtime

ARG SOURCE_SHA

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libpq5 \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge 20250419~deb12u2 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 nexus \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent \
        --shell /usr/sbin/nologin nexus

WORKDIR /app

COPY --from=python-builder /app/.venv /app/.venv
COPY python/nexus ./nexus
COPY migrations ./migrations
COPY --from=release-metadata --chown=0:0 --chmod=0444 /app/runtime-identity.json /app/runtime-identity.json

RUN chmod -R u=rwX,go=rX /app/nexus /app/migrations

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app"

LABEL org.opencontainers.image.source="https://github.com/NielsdaWheelz/nexus-web"
LABEL org.opencontainers.image.revision=$SOURCE_SHA


FROM backend-runtime AS api

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl postgresql-client-15 \
    && rm -rf /var/lib/apt/lists/*

# Return freed large buffers instead of raising glibc's retention thresholds.
# This trades allocator contention and mmap calls for lower resident memory.
ENV MALLOC_ARENA_MAX=2 \
    MALLOC_MMAP_THRESHOLD_=131072 \
    MALLOC_TRIM_THRESHOLD_=131072

COPY apps/api ./apps/api

RUN chmod -R u=rwX,go=rX /app/apps/api

USER nexus:nexus

EXPOSE 8000
# Cancel persistent streams before the production container's 30s stop grace.
CMD ["uvicorn", "apps.api.main:app", "--loop", "asyncio", "--host", "0.0.0.0", "--port", "8000", "--timeout-graceful-shutdown", "20"]


# Checkout workers install dependencies only; all application source and identity
# are explicit read-only binds. Keep the immutable release runtime above intact.
FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2 AS worker-checkout

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libpq5 \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' ca-certificates)" ge 20250419~deb12u2 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 nexus \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /nonexistent \
        --shell /usr/sbin/nologin nexus \
    && install --directory --owner=nexus --group=nexus --mode=0700 /var/lib/nexus-codex \
    && install --directory --owner=nexus --group=nexus --mode=0700 /tmp/codex-daemon-10001 \
    && mkdir /workspace

WORKDIR /app

COPY docker/codex-requirements.toml /etc/codex/requirements.toml
COPY --from=worker-python-dependencies /app/.venv /app/.venv
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-builder /app/node/ingest/node_modules ./node/ingest/node_modules

ENV PATH="/app/.venv/bin:$PATH" PYTHONPATH="/app"
ENV NODE_ENV="production" NODE_INGEST_SCRIPT="/app/node/ingest/ingest.mjs"

USER nexus:nexus

CMD ["python", "-m", "apps.worker.main"]


FROM backend-runtime AS worker-runtime

RUN install --directory --owner=nexus --group=nexus --mode=0700 /var/lib/nexus-codex \
    && install --directory --owner=nexus --group=nexus --mode=0700 /tmp/codex-daemon-10001


FROM worker-runtime AS worker

RUN mkdir /workspace
COPY docker/codex-requirements.toml /etc/codex/requirements.toml

COPY --from=worker-python-builder /app/.venv /app/.venv
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-builder /app/node/ingest/node_modules ./node/ingest/node_modules
COPY node/ingest/ingest.mjs ./node/ingest/ingest.mjs
COPY node/ingest/article_extraction.mjs ./node/ingest/article_extraction.mjs
COPY apps/worker ./apps/worker
COPY apps/codex_agent ./apps/codex_agent

RUN chmod -R u=rwX,go=rX /app/node/ingest /app/apps/worker /app/apps/codex_agent \
    && node --version

ENV NODE_ENV="production" NODE_INGEST_SCRIPT="/app/node/ingest/ingest.mjs"

USER nexus:nexus

CMD ["python", "-m", "apps.worker.main"]
